		<div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6'>
			<MemberCard name='Prakhar Shankar' role='Master Student (Cosupervised)' presentAffiliation='Indus Insights' compact />
			<MemberCard name='Anjali Jaiswal' role='Masters (Cosupervised)' presentAffiliation='Tata Electronics' compact />
