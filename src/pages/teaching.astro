---
import Layout from '@/layouts/Layout.astro'

const courses = [
	{
		term: 'Spring 2026',
		course: 'Internet of Things',
		institution: 'IIT Guwahati',
	},
	{
		term: 'Spring 2026',
		course: 'Hardware Aware Deep Learning',
		institution: 'Coursera',
	},
	{
		term: 'Fall 2025',
		course: 'Hardware Aware Deep Learning',
		institution: 'IIT Guwahati',
	},
	{
		term: 'Fall 2025',
		course: 'Neuromorphic AI',
		institution: 'IIT Guwahati',
	},
	{
		term: 'Summer 2026, Summer 2025, Summer 2024',
		course: 'Introduction to R Programming',
		institution: 'Coursera',
	},
	{
		term: 'Spring 2025',
		course: 'Deep Learning',
		institution: 'IIT Guwahati',
	},
	{
		term: 'Spring 2026, Spring 2025, Spring 2024',
		course: 'Data Mining',
		institution: 'IIT Guwahati',
	},
	{
		term: 'Spring 2026, Spring 2025',
		course: 'Data Mining & Warehousing',
		institution: 'Coursera',
	},
	{
		term: 'Fall 2024',
		course: 'Machine Learning',
		institution: 'IIT Guwahati',
	},
	{
		term: 'Fall 2024',
		course: 'Machine Learning Lab',
		institution: 'IIT Guwahati',
	},
	{
		term: 'Spring 2024',
		course: 'Data Visualization Lab',
		institution: 'IIT Guwahati',
	},
	{
		term: 'Summer 2023',
		course: 'Programming for AI',
		institution: 'IIT Hyderabad',
	},
	{
		term: 'Spring 2023',
		course: 'Neuromorphic AI',
		institution: 'IIT Hyderabad',
	},
]
---

<Layout title='Teaching • SustainAI Lab'>
	<h1 class='text-3xl font-bold mb-8'>Courses Taught</h1>
	<div class='grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6'>
		{
			courses.map(({ term, course, institution }) => (
				<div class='card bg-base-200'>
					<div class='card-body p-5 flex flex-col justify-between min-h-[120px]'>
						<div>
							<p class='text-xs font-semibold text-accent mb-2'>{term}</p>
							<h2 class='text-sm font-semibold'>{course}</h2>
						</div>
						<p class='italic text-base-content/70 text-xs mt-4'>{institution}</p>
					</div>
				</div>
			))
		}
	</div>
</Layout>
