---
import Layout from '@/layouts/Layout.astro'
import { highlightAuthor } from '@/lib/utils'
import publicationsData from '@/data/Ayon_borthakur.json'

const years = Array.from(new Set(publicationsData.map((pub) => pub.year))).sort((a, b) => b - a)
---

<Layout title='Publications • SustainAI Lab' description='Publications by SustainAI Lab'>
	<h1 class='text-3xl font-bold mb-8'>Publications</h1>
	{
		years.map((year) => (
			<section class='mb-10'>
				<h2 class='text-2xl font-bold mb-6'>{year}</h2>
				<div class='space-y-6'>
					{publicationsData
						.filter((pub) => pub.year === year && pub.type !== 'Patent')
						.map((publication) => (
							<div class='card bg-base-200'>
								<div class='card-body'>
									<h3 class='card-title text-xl'>
										<a
											href={publication.citation_url}
											target='_blank'
											rel='noopener noreferrer'
											class='hover:text-accent'
										>
											{publication.title}
										</a>
									</h3>
									<p class='text-base mb-2'>
										<span set:html={highlightAuthor(publication.authors.join(', '))} />
									</p>
									<p class='text-sm italic text-base-content/80'>{publication.source}</p>
									{publication.cites_url && (
										<div class='card-actions justify-end mt-2'>
											<a
												href={publication.cites_url}
												target='_blank'
												rel='noopener noreferrer'
												class='btn btn-sm btn-secondary text-secondary-content'
											>
												Citations
											</a>
										</div>
									)}
								</div>
							</div>
						))}
				</div>
			</section>
		))
	}
</Layout>
